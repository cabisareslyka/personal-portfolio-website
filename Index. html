<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Lyka | Computer Science Student</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: #f4f7fb;
            color: #1f2937;
            line-height: 1.7;
        }

        /* NAVIGATION */
        nav {
            position: sticky;
            top: 0;
            z-index: 1000;
            background: rgba(255,255,255,0.97);
            padding: 15px 10px;
            text-align: center;
            box-shadow: 0 3px 15px rgba(0,0,0,0.08);
        }

        nav a {
            display: inline-block;
            margin: 5px 7px;
            color: #374151;
            text-decoration: none;
            font-weight: bold;
            font-size: 13px;
        }

        nav a:hover {
            color: #168dcc;
        }

        /* HERO */
        .hero {
            min-height: 88vh;
            display: flex;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 50px 20px;
            background: linear-gradient(135deg, #087db5, #36b5dc);
            color: white;
        }

        .hero-content {
            max-width: 850px;
        }

        .profile-photo {
            width: 180px;
            height: 180px;
            object-fit: cover;
            border-radius: 50%;
            border: 5px solid white;
            margin-bottom: 20px;
            box-shadow: 0 8px 25px rgba(0,0,0,0.25);
        }

        .hero h1 {
            font-size: clamp(42px, 8vw, 70px);
            margin-bottom: 8px;
        }

        .hero h2 {
            font-size: clamp(20px, 4vw, 30px);
            margin-bottom: 8px;
        }

        .hero p {
            color: #ffffff;
            font-size: 18px;
        }

        .tag {
            display: inline-block;
            margin: 22px 5px 0;
            padding: 9px 18px;
            border: 1px solid rgba(255,255,255,0.7);
            border-radius: 30px;
            font-size: 13px;
        }

        /* SECTIONS */
        section {
            max-width: 1050px;
            margin: 35px auto;
            padding: 45px;
            background: white;
            border-radius: 20px;
            box-shadow: 0 8px 30px rgba(0,0,0,0.06);
        }

        section h2 {
            color: #111827;
            font-size: 30px;
            margin-bottom: 25px;
        }

        section h2::after {
            content: "";
            display: block;
            width: 55px;
            height: 4px;
            background: #159bd0;
            margin-top: 8px;
            border-radius: 5px;
        }

        /* ABOUT */
        .about-text {
            color: #4b5563;
            font-size: 17px;
        }

        /* CARDS */
        .cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
            gap: 18px;
        }

        .card {
            padding: 22px;
            background: #f8fafc;
            border: 1px solid #e5e7eb;
            border-radius: 15px;
            transition: 0.3s;
        }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(21,155,208,0.15);
        }

        .card h3 {
            color: #168dcc;
            font-size: 17px;
        }

        /* SKILLS */
        .skill-badges {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 10px;
            margin-bottom: 30px;
        }

        .badge {
            background: #159bd0;
            color: white;
            padding: 10px 18px;
            border-radius: 5px;
            font-weight: bold;
            letter-spacing: 2px;
            font-size: 14px;
        }

        .skill-list {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
            gap: 12px;
        }

        .skill-item {
            padding: 15px;
            background: #f8fafc;
            border-radius: 10px;
            border-left: 4px solid #159bd0;
        }

        /* PROJECT */
        .project {
            padding: 30px;
            background: #f8fbff;
            border-left: 5px solid #159bd0;
            border-radius: 15px;
        }

        .project h3 {
            color: #168dcc;
            margin-bottom: 12px;
        }

        /* AGILE */
        .process {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            align-items: center;
            gap: 10px;
        }

        .step {
            background: #159bd0;
            color: white;
            padding: 13px 18px;
            border-radius: 8px;
            font-weight: bold;
        }

        .arrow {
            color: #168dcc;
            font-weight: bold;
            font-size: 20px;
        }

        /* GOAL */
        .goal {
            text-align: center;
            font-size: 22px;
            font-weight: bold;
            color: #1f2937;
        }

        /* JOURNEY */
        .journey {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 15px;
            margin-bottom: 25px;
        }

        .journey-step {
            text-align: center;
            padding: 20px 10px;
            background: #159bd0;
            color: white;
            border-radius: 10px;
            font-weight: bold;
            letter-spacing: 3px;
        }

        /* QUOTE */
        .quote-box {
            text-align: center;
            padding: 40px 20px;
            background: #f8fafc;
            border-radius: 18px;
        }

        .quote {
            font-size: 25px;
            font-style: italic;
            color: #374151;
            margin-bottom: 25px;
        }

        .thank-you {
            font-weight: bold;
            color: #168dcc;
            margin-top: 8px;
        }

        /* FOOTER */
        footer {
            background: #111827;
            color: white;
            text-align: center;
            padding: 30px 20px;
            margin-top: 50px;
        }

        /* MOBILE */
        @media (max-width: 700px) {

            nav a {
                font-size: 11px;
                margin: 3px 4px;
            }

            section {
                margin: 20px 12px;
                padding: 28px 22px;
            }

            section h2 {
                font-size: 26px;
            }

            .profile-photo {
                width: 150px;
                height: 150px;
            }

            .journey {
                grid-template-columns: repeat(2, 1fr);
            }

            .process {
                flex-direction: column;
            }

            .arrow {
                display: none;
            }
        }
    </style>
</head>

