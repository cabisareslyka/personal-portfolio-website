<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Lyka | Computer Science Student</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: #f4f7fb;
            color: #1f2937;
            line-height: 1.7;
        }

        /* NAVIGATION */
        nav {
            position: sticky;
            top: 0;
            z-index: 1000;
            background: rgba(255, 255, 255, 0.96);
            backdrop-filter: blur(10px);
            padding: 16px 20px;
            text-align: center;
            box-shadow: 0 3px 15px rgba(0, 0, 0, 0.08);
        }

        nav a {
            display: inline-block;
            margin: 5px 8px;
            color: #374151;
            text-decoration: none;
            font-weight: bold;
            font-size: 14px;
            transition: 0.3s;
        }

        nav a:hover {
            color: #2563eb;
        }

        /* HERO */
        .hero {
            min-height: 90vh;
            display: flex;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 60px 20px;
            background: linear-gradient(135deg, #111827, #2563eb);
            color: white;
        }

        .hero-content {
            max-width: 850px;
        }

        .hero h1 {
            font-size: clamp(45px, 8vw, 80px);
            margin-bottom: 10px;
        }

        .hero h2 {
            font-size: clamp(20px, 4vw, 30px);
            font-weight: normal;
            margin-bottom: 10px;
        }

        .hero p {
            color: #e5e7eb;
            margin: 8px 0;
        }

        .hero-tag {
            display: inline-block;
            margin-top: 25px;
            padding: 10px 20px;
            border: 1px solid rgba(255,255,255,0.5);
            border-radius: 30px;
            font-size: 14px;
        }

        /* SECTIONS */
        section {
            max-width: 1050px;
            margin: 35px auto;
            padding: 45px;
            background: white;
            border-radius: 20px;
            box-shadow: 0 8px 30px rgba(0,0,0,0.06);
        }

        section h2 {
            color: #111827;
            font-size: 30px;
            margin-bottom: 25px;
            position: relative;
        }

        section h2::after {
            content: "";
            display: block;
            width: 55px;
            height: 4px;
            background: #2563eb;
            margin-top: 8px;
            border-radius: 5px;
        }

        /* ABOUT */
        .about-text {
            font-size: 17px;
            color: #4b5563;
        }

        /* CARDS */
        .cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
            gap: 18px;
        }

        .card {
            padding: 22px;
            background: #f8fafc;
            border: 1px solid #e5e7eb;
            border-radius: 15px;
            transition: 0.3s;
        }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(37, 99, 235, 0.12);
            border-color: #93c5fd;
        }

        .card h3 {
            color: #2563eb;
            margin-bottom: 8px;
        }

        /* SKILLS */
        .skills {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
            gap: 15px;
        }

        .skill {
            text-align: center;
            padding: 18px;
            background: #eff6ff;
            color: #1d4ed8;
            border-radius: 12px;
            font-weight: bold;
            border: 1px solid #dbeafe;
            transition: 0.3s;
        }

        .skill:hover {
            transform: scale(1.03);
        }

        /* PROJECT */
        .project-card {
            padding: 30px;
            background: linear-gradient(135deg, #eff6ff, #ffffff);
            border-left: 5px solid #2563eb;
            border-radius: 15px;
        }

        .project-card h3 {
            color: #1d4ed8;
            font-size: 22px;
            margin-bottom: 12px;
        }

        /* AGILE PROCESS */
        .process {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            align-items: center;
            gap: 10px;
        }

        .step {
            background: #111827;
            color: white;
            padding: 13px 18px;
            border-radius: 10px;
            font-weight: bold;
        }

        .arrow {
            color: #2563eb;
            font-weight: bold;
        }

        /* GOAL */
        .goal {
            text-align: center;
            font-size: 19px;
            color: #4b5563;
        }

        /* JOURNEY */
        .journey {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 15px;
            margin-top: 25px;
        }

        .journey-step {
            text-align: center;
            padding: 22px 10px;
            background: #f8fafc;
            border-radius: 15px;
            font-weight: bold;
            color: #2563eb;
            border: 1px solid #e5e7eb;
        }

        /* QUOTE */
        .quote-box {
            text-align: center;
            padding: 40px 20px;
            background: linear-gradient(135deg, #eff6ff, #f8fafc);
            border-radius: 18px;
        }

        .quote {
            font-size: 25px;
            font-style: italic;
            color: #374151;
            margin-bottom: 25px;
        }

        .thank-you {
            font-weight: bold;
            color: #2563eb;
        }

        /* FOOTER */
        footer {
            text-align: center;
            padding: 35px 20px;
            background: #111827;
            color: white;
            margin-top: 50px;
        }

        footer p {
            margin: 5px;
        }

        /* MOBILE */
        @media (max-width: 700px) {

            nav {
                padding: 12px 8px;
            }

            nav a {
                font-size: 12px;
                margin: 3px 4px;
            }

            .hero {
                min-height: 80vh;
            }

            section {
                margin: 20px 12px;
                padding: 28px 22px;
                border-radius: 15px;
            }

            section h2 {
                font-size: 26px;
            }

            .journey {
                grid-template-columns: repeat(2, 1fr);
            }

            .process {
                flex-direction: column;
            }

            .arrow {
                display: none;
            }
        }
    </style>
</head>

