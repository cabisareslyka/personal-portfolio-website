<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lyka | Personal Portfolio</title>

    <style>
        * {
            box-sizing: border-box;
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            font-family: Arial, Helvetica, sans-serif;
            color: #263238;
            background: #f4f9fc;
            line-height: 1.7;
        }

        /* NAVIGATION */
        nav {
            position: sticky;
            top: 0;
            z-index: 1000;
            background: rgba(255, 255, 255, 0.97);
            padding: 15px 20px;
            text-align: center;
            border-bottom: 1px solid #d9e6ec;
            box-shadow: 0 3px 12px rgba(0, 0, 0, 0.08);
        }

        nav a {
            display: inline-block;
            color: #263238;
            text-decoration: none;
            margin: 5px 7px;
            padding: 7px 10px;
            font-size: 13px;
            font-weight: bold;
            border-radius: 20px;
            transition: 0.3s;
        }

        nav a:hover {
            color: white;
            background: #159bd0;
        }

        /* MAIN CONTAINER */
        .container {
            max-width: 1000px;
            margin: auto;
            padding: 25px;
        }

        /* HERO */
        .hero {
            text-align: center;
            padding-bottom: 50px;
        }

        .banner {
            background: linear-gradient(135deg, #159bd0, #65cbe9);
            color: white;
            padding: 55px 20px;
            margin-bottom: 35px;
            border-radius: 0 0 35px 35px;
            box-shadow: 0 8px 25px rgba(21, 155, 208, 0.25);
        }

        .banner h1 {
            margin: 0;
            font-size: 42px;
        }

        .profile-photo {
            width: 245px;
            height: 245px;
            object-fit: cover;
            display: block;
            margin: -5px auto 25px;
            border-radius: 50%;
            border: 8px solid white;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.18);
        }

        .hero h2 {
            font-size: 36px;
            margin: 10px 0;
            color: #123b4a;
        }

        .hero p {
            font-size: 21px;
            color: #52666f;
        }

        .labels {
            margin: 25px auto 10px;
            max-width: 700px;
        }

        .label {
            display: inline-block;
            padding: 9px 17px;
            margin: 5px;
            background: #159bd0;
            color: white;
            font-size: 12px;
            letter-spacing: 2px;
            font-weight: bold;
            border-radius: 25px;
            box-shadow: 0 4px 10px rgba(21, 155, 208, 0.2);
        }

        /* SECTIONS */
        section {
            padding: 55px 30px;
            margin: 30px 0;
            background: white;
            border-radius: 22px;
            box-shadow: 0 6px 25px rgba(32, 75, 92, 0.08);
            border: 1px solid #e2eef3;
        }

        section h2 {
            font-size: 32px;
            margin: 0 0 25px;
            color: #123b4a;
            text-align: center;
        }

        section h2::after {
            content: "";
            display: block;
            width: 55px;
            height: 4px;
            background: #159bd0;
            margin: 10px auto 0;
            border-radius: 10px;
        }

        section p {
            font-size: 18px;
        }

        /* LISTS */
        ul {
            font-size: 18px;
            padding-left: 25px;
            max-width: 750px;
            margin: auto;
        }

        li {
            margin: 12px 0;
        }

        li::marker {
            color: #159bd0;
        }

        /* SKILLS */
        .skills {
            text-align: center;
            margin: 25px 0;
        }

        .skill {
            display: inline-block;
            background: #159bd0;
            color: white;
            padding: 11px 20px;
            margin: 6px;
            font-weight: bold;
            letter-spacing: 2px;
            border-radius: 25px;
            transition: 0.3s;
        }

        .skill:hover {
            transform: translateY(-4px);
            background: #117faa;
        }

        /* PROJECT */
        .project-title {
            font-size: 26px;
            font-weight: bold;
            color: #159bd0;
            text-align: center;
        }

        #projects p {
            max-width: 750px;
            margin: 15px auto;
            text-align: center;
        }

        /* AGILE PROCESS */
        #process p {
            text-align: center;
            font-size: 20px;
            font-weight: bold;
            color: #159bd0;
            background: #edf8fc;
            padding: 22px;
            border-radius: 15px;
            max-width: 800px;
            margin: auto;
        }

        /* GOAL */
        .goal {
            font-size: 30px !important;
            font-weight: bold;
            text-align: center;
            color: #159bd0;
            max-width: 800px;
            margin: auto;
        }

        /* JOURNEY */
        .journey {
            text-align: center;
            margin: 30px 0;
        }

        .journey span {
            display: inline-block;
            background: #159bd0;
            color: white;
            padding: 13px 22px;
            margin: 5px;
            font-weight: bold;
            letter-spacing: 2px;
            border-radius: 25px;
            box-shadow: 0 4px 10px rgba(21, 155, 208, 0.2);
        }

        .journey-text {
            text-align: center;
            font-size: 20px;
            font-style: italic;
            color: #52666f;
        }

        /* QUOTE */
        .quote {
            text-align: center;
            font-size: 27px;
            font-style: italic;
            color: #159bd0;
            font-weight: bold;
            max-width: 750px;
            margin: 30px auto;
        }

        .thank-you {
            text-align: center;
            font-size: 22px;
            font-weight: bold;
        }

        .keep {
            text-align: center;
            font-size: 18px;
            color: #52666f;
        }

        /* MOBILE */
        @media (max-width: 600px) {

            nav {
                padding: 10px;
            }

            nav a {
                font-size: 10px;
                margin: 3px;
                padding: 6px 8px;
            }

            .container {
                padding: 12px;
            }

            .banner {
                padding: 40px 15px;
                border-radius: 0 0 25px 25px;
            }

            .banner h1 {
                font-size: 30px;
            }

            .profile-photo {
                width: 200px;
                height: 200px;
            }

            .hero h2 {
                font-size: 28px;
            }

            .hero p {
                font-size: 17px;
            }

            .label {
                font-size: 10px;
                letter-spacing: 1px;
            }

            section {
                padding: 40px 20px;
                margin: 20px 0;
                border-radius: 18px;
            }

            section h2 {
                font-size: 27px;
            }

            section p,
            ul {
                font-size: 16px;
            }

            .project-title {
                font-size: 22px;
            }

            #process p {
                font-size: 16px;
            }

            .goal {
                font-size: 23px !important;
            }

            .journey span {
                padding: 10px 15px;
                font-size: 13px;
            }

            .quote {
                font-size: 22px;
            }
        }
    </style>
</head>

